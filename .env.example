# ==========================================================
# NetGuardian Email & Security Configuration
# ==========================================================

# 1. GMAIL ACCOUNT (required for both delivery methods)
NETGUARDIAN_EMAIL_USER=yourgmail@gmail.com

# 2. GMAIL REST API — PRIMARY METHOD (works on firewalled/school networks)
#    Sends email over HTTPS port 443. Set up once via Google Cloud Console.
#    Step-by-step: https://developers.google.com/gmail/api/quickstart/python
#
#    Quick steps:
#      a) Go to https://console.cloud.google.com/ → New Project
#      b) APIs & Services → Enable "Gmail API"
#      c) OAuth consent screen → External → add your Gmail as test user
#      d) Credentials → Create OAuth 2.0 Client ID → Desktop App → Download JSON
#      e) Run:  python get_gmail_token.py
#      f) Paste the three values below
NETGUARDIAN_GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
NETGUARDIAN_GMAIL_CLIENT_SECRET=your_client_secret_here
NETGUARDIAN_GMAIL_REFRESH_TOKEN=your_refresh_token_here

# 3. GMAIL APP PASSWORD — FALLBACK METHOD (used if REST API not configured)
#    Only works on networks that allow outbound SMTP (ports 465/587).
#    Generate at: https://myaccount.google.com/apppasswords
NETGUARDIAN_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# 4. APPLICATION SETTINGS
NETGUARDIAN_SECRET_KEY=replace_with_very_long_random_key
NETGUARDIAN_SECURE_COOKIES=true
NETGUARDIAN_DEBUG=false
